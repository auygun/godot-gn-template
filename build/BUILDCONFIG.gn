declare_args() {
  is_debug = false

  is_clang = false

  # Map to GCC on linux; the msvc toolchain and NDK clang override these.
  ar = "ar"
  cc = "cc"
  cxx = "c++"

  # Useful for tools like 'ccache' and 'icecc' to speed up compilation.
  compile_preprocess = ""

  # Android NDK root (required when target_os = "android").
  ndk = ""
  ndk_api = 24

  # -Werror / /WX for the game code (godot-cpp never uses it).
  treat_warnings_as_errors = true

  # Skip the apk target: plain `ninja` then builds only libextension.so.
  no_apk = false

  # Godot editor binary the smoke_test and apk actions and the godot-cpp
  # binding generation use: an absolute path, or a name looked up on PATH.
  engine_binary = "godot"
}

if (is_clang) {
  cc = "clang"
  cxx = "clang++"
} else if (cc == "clang" && cxx == "clang++") {
  is_clang = true
}

if (compile_preprocess == "" &&
    exec_script("check_binary.py", [ "ccache" ], "value") == 1) {
  compile_preprocess = "ccache"
}

# Platform detection
if (target_os == "") {
  target_os = host_os
}
if (current_os == "") {
  current_os = target_os
}

is_android = current_os == "android"
is_linux = current_os == "linux"
is_win = current_os == "win"

if (target_cpu == "") {
  if (is_android) {
    target_cpu = "arm64"
  } else {
    target_cpu = host_cpu
  }
}
if (target_cpu == "x86_64") {
  target_cpu = "x64"
}
if (current_cpu == "") {
  current_cpu = target_cpu
}

if (is_android) {
  assert(ndk != "", "ndk argument is empty (set it to the NDK root path)")

  ndk_host = ""
  ndk_target = ""

  if (host_os == "linux") {
    ndk_host = "linux-x86_64"
  } else if (host_os == "win") {
    ndk_host = "windows-x86_64"
  }

  if (target_cpu == "arm64") {
    ndk_target = "aarch64-linux-android"
  } else if (target_cpu == "arm") {
    ndk_target = "armv7a-linux-androideabi"
  } else if (target_cpu == "x64") {
    ndk_target = "x86_64-linux-android"
  } else if (target_cpu == "x86") {
    ndk_target = "i686-linux-android"
  }

  _prefix = "$ndk/toolchains/llvm/prebuilt/$ndk_host/bin"
  if (host_os == "win") {
    ar = "$_prefix/llvm-ar.exe"
    cc = "$_prefix/clang.exe --target=$ndk_target$ndk_api -fno-addrsig"
    cxx = "$_prefix/clang++.exe --target=$ndk_target$ndk_api -fno-addrsig"
  } else {
    ar = "$_prefix/llvm-ar"
    cc = "$_prefix/$ndk_target$ndk_api-clang"
    cxx = "$_prefix/$ndk_target$ndk_api-clang++"
  }
}

# Set defaults
_default_config = [
  "//build:default",
  "//build:warnings",
]

if (is_debug) {
  _default_config += [ "//build:debug" ]
} else {
  _default_config += [ "//build:release" ]
}

set_defaults("static_library") {
  configs = _default_config
}
set_defaults("shared_library") {
  configs = _default_config
}
set_defaults("source_set") {
  configs = _default_config
}

if (is_win) {
  set_default_toolchain("//build/toolchain/msvc")
} else {
  # Clang (including the Android NDK clang) behaves like GCC in most cases.
  set_default_toolchain("//build/toolchain/gcc")
}
